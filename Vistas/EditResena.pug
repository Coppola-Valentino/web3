include bar.pug
+bar()
block content
div(style="max-width: 1500px; border: 5px solid #000000ff; margin: 0 auto; padding-left: 10px; padding-right: 10px; display: flex; justify-content: space-between; flex-direction: column; horizontal-align: center; margin-top: 80px; background: rgba(255, 255, 255, 1)")
         h1 Resena
         h3 #{juego.Nombre}
         form(action=`/EditResena/${juego.IDJuego}/${resena.IDResena}` method="POST" id="formi" style="display: flex; flex-direction: column; gap: 1px;" )
           label(for="Numero") De un 0 al 10, como calificarias el juego:
           input(type="number" name="Numero" id="Numero" required value=resena.Numero)
           br
           label(for="Texto") Razones:
           input(type="text" name="Texto" id="Texto" required value=resena.Texto)
           br
           button(class="btn btn-primary" type="submit") Guardar
           br
div(class="Container-fluid text-center justify-content-center")      
 div(class="col btn btn-link" style="Padding-bottom: 40px;")
  a.btn.btn-warning(href=`/VerJuego/${juego.IDJuego}`) Volver
  br
script.
                document.getElementById('formi').addEventListener('submit', function(event) {
                  const TexImp = document.getElementById('Texto');
                  const NumImp = document.getElementById('Numero');
                  if (TexImp.value.length > 200) {
                    alert('La Reseña solo Puede tener hasta 200 caracteres');
                    event.preventDefault();
                  }
                  if (NumImp.value < 0 || NumImp.value > 10) {
                    alert('Numero No Valido.');
                    event.preventDefault();
                  }
                 });