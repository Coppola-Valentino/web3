include bar.pug
+bar()
block content
div(style="max-width: 1500px; border: 5px solid #000000ff; margin: 0 auto; padding-left: 10px; padding-right: 10px; display: flex; justify-content: space-between; flex-direction: column; horizontal-align: center; margin-top: 20px; background: rgba(255, 255, 255, 1)")
         h1 Administrar Tarjeta
         form(action=`/EditTarjeta/${tarjeta.IDTarjeta}` method="POST" id="formi" style="display: flex; flex-direction: column; gap: 1px;" )
           label(for="Nombre") Nombre:
           input(type="text" name="Nombre" id="Nombre" required value=tarjeta.Nombre)
           br
           label(for="Saldo") Saldo:
           input(type="text" name="Saldo" id="Saldo" required value=tarjeta.Saldo)
           br
           button(class="btn btn-primary" type="submit") Guardar
           br
div(class="Container-fluid text-center justify-content-center")      
 div(class="col btn btn-link" style="Padding-bottom: 40px;")
  a.btn.btn-warning(href=`/VerTarjeta`) Volver
  br
script.
                document.getElementById('formi').addEventListener('submit', function(event) {
                  const NomImp = document.getElementById('Nombre');
                  if (NomImp.value.length > 20 || NomImp.value.length < 3) {
                    alert('El Nombre debe tener entre 3 y 20 caracteres');
                    event.preventDefault();
                  }
                 });