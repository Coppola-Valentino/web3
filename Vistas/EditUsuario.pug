include bar.pug
+bar()
block content
div(style="max-width: 1500px; border: 5px solid #000000ff; margin: 0 auto; padding-left: 10px; padding-right: 10px; display: flex; justify-content: space-between; flex-direction: column; horizontal-align: center; margin-top: 20px; background: rgba(255, 255, 255, 1)")
         h1 Añadir juego
         form(action=`/EditUsuario/${user.IDUser}` method="POST" id="formi" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 1px;" )
           label(for="Nombre") Nombre:
           input(type="text" name="Nombre" id="Nombre" required value=user.Nombre)
           br
           label(for="Pass") Contraseña:
           input(type="double" name="Pass" id="Pass" required value=user.Pass)
           button(type="button" id="buton" style="max-width: 150px; max-height: 45px; margin-top: 5px;" onclick="PassToggle()") Mostrar/Ocultar
           br
           label(for="Email") Email:
           input(type="text" name="Email" id="Email" required value=user.Email)
           br
           label(for="Avatar") Avatar:
           input(type="file" name="Avatar" id="Avatar" accept="image/*" value=user.Avatar)
           br
           label(for="mantener") Conservar imagen actual
           input(type="checkbox" style="max-width: 170px; margin-top: 10px;" name="mantener" id="mantener" checked)
           br
           p Avatar Actual:
           img(src=`/imagenes/${user.Avatar}` alt="Avatar actual" style="max-width: 200px; max-height: 200px;") 
           br
           if activeUser.Admin == 1 || activeUser.Admin == true 
            label(for="Admin") Habilitar como Admininistrador:
            input(type="checkbox" style="max-width: 170px; margin-top: 10px;" name="Admin" id="Admin" value=user.Admin) 
            br
           button(class="btn btn-primary" type="submit") Guardar
           br
           a.btn.btn-warning(href=`/VerUsuario/${user.IDUser}`) Cancelar
           br
           script.
                function PassToggle() {
                  const pass = document.getElementById('Pass');
                  if (pass.type === "password") {
                    pass.type = "text";
                  } else {
                    pass.type = "password";
                }};
                document.getElementById('formi').addEventListener('submit', function(event) {
                  const userImp = document.getElementById('Nombre');
                  const EmaImp = document.getElementById('Email')
                  if (userImp.value.length > 20 || userImp.value.length < 6) {
                    alert('El usuario debe tener entre 6 y 20 caracteres');
                    event.preventDefault();
                  }
                  const passImp = document.getElementById('Pass');
                  if (passImp.value.length > 30) {
                    alert('La contraseña no puede tener más de 30 digitos.');
                    event.preventDefault();
                  }
                  if (passImp.value.length < 6) {
                    alert('La contraseña no puede tener menos de 6 digitos.');
                    event.preventDefault();
                  }
                  if (passImp.value.search(/[0-9]/) == -1 || passImp.value.search(/[a-z]/i) == -1 || passImp.value.search(/[A-Z]/i) == -1 || passImp.value.search(/[^a-zA-Z0-9]/) == -1) {
                    alert('La contraseña debe contener almenos un numero, una Mayuscula, una minuscula y un caracter especial.');
                    event.preventDefault();
                  }
                  if (EmaImp.value.search(/^\w+@\w+\.(com|edu|ar)/) == -1) {
                    alert('El email no es valido.');
                    event.preventDefault();
                  }
                 });