include bar.pug
+bar()
block content
div(style="max-width: 1500px; border: 5px solid #000000ff; margin: 0 auto; padding-left: 10px; padding-right: 10px; display: flex; justify-content: space-between; flex-direction: column; horizontal-align: center; margin-top: 80px; background: rgba(255, 255, 255, 1)")
        h1 Floppy Disk Grand Opening!
        if typeof juegos !== 'undefined' && juegos.length
            div(id="juegosCarousel" class="carousel slide" data-bs-ride="carousel" style="width: 800px; margin: 0 auto;")
                div(class="carousel-inner")
                    each juego, i in juegos
                        div(class=i === 0 ? "carousel-item active" : "carousel-item")
                            a(href=`/VerJuego/${juego.IDJuego}`)
                                img(src=juego.Imagen, alt=juego.Nombre, style="width:100%; height:400px; object-fit:cover;")
                                div(class="carousel-caption d-none d-md-block")
                                    h5 #{juego.Nombre}
                                    p #{juego.Descripcion}
                button.carousel-control-prev(type="button" data-bs-target="#juegosCarousel" data-bs-slide="prev")
                    span.carousel-control-prev-icon(aria-hidden="true")
                    span.visually-hidden Previous
                button.carousel-control-next(type="button" data-bs-target="#juegosCarousel" data-bs-slide="next")
                    span.carousel-control-next-icon(aria-hidden="true")
                    span.visually-hidden Next
        else
            p No hay juegos disponibles.