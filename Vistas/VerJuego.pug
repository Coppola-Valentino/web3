include bar.pug
+bar()
block content
        div(style="max-width: 1500px; border: 5px solid #000000ff; margin: 0 auto; padding-left: 10px; padding-right: 10px; display: flex; justify-content: space-between; flex-direction: column; horizontal-align: center; margin-top: 80px; background: rgba(255, 255, 255, 1)")
         div(class="Container-fluid text-center justify-content-center")
          br
          h1 #{juego.Nombre}
          div(class="col btn btn-link" style="border: 5px solid #000000ff; display: inline-block; background: rgb(56, 56, 56);") 
           img(src=`/Imagenes/${juego.Imagen}`, alt="Imagen", style="width:200px; height:200px; object-fit:cover;")
          if juego.Estado == 'Baneado'
            br
            strong 
             p(style="color: red;") (El Juego se encuentra Baneado de la plataforma) 
         br
         if juego.Precio == 0
          h2 Precio: Free to Play
         else 
          h2 Precio: $#{juego.Precio}
         br
         div(class="Container-fluid text-center justify-content-center")
          p Desarrollado por:
          a(href=`/verTeam/${team.IDTeam}`)
           p #{team.Nombre} 
          p Publicado por:
          if publisher
           a(href=`/verPublisher/${publisher.IDPublisher}`)
            p #{publisher.Nombre} 
          else
           p Independiente
          br
         h3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Descripcion ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
         div(style="border: 5px solid #000000ff; display: inline-block; padding-left: 5px; background: rgb(204, 204, 204);")
          p #{juego.Descripcion}
         br
         h3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Categorias ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
         div(class="Container-fluid text-center justify-content-center")
            for categs in categorias
             div(class="col btn")
              div(style="border: 2px solid #000000ff; display: inline-block; padding: 10px; background: rgb(204, 204, 204);")
               p #{categs.Contenido}
         br
         h3 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
         br
         div(class="Container-fluid text-center justify-content-center") 
          if licencia == null
           if juego.Precio > 0
            div(class="col btn btn-link" style="Padding-bottom: 40px;")  
             a.btn.btn-success(href=`/ConfirmarComp/${juego.IDJuego}`) Comprar
             br
           else
            div(class="col btn btn-link" style="Padding-bottom: 40px;")  
             a.btn.btn-success(href=`/FreeToPlay/${juego.IDJuego}`) Añadir a Libreria
             br
          else
           if licencia.Estado == 'Activa' && juego.Archivo
            div(class="col btn btn-link" style="Padding-bottom: 40px;")  
             a.btn.btn-primary(href=`/DescargarJuego/${juego.IDJuego}`) Descargar
             br
            div(class="col btn btn-link" style="Padding-bottom: 40px;")  
             a.btn.btn-info(href=`/VerUpdates/${juego.IDJuego}`) Historial de Updates
             br
            if resen == null
             div(class="col btn btn-link" style="Padding-bottom: 40px;")  
              a.btn.btn-info(href=`/CrearResena/${juego.IDJuego}`) Escribir Reseña
              br
            else 
             div(class="col btn btn-link" style="Padding-bottom: 40px;")  
              a.btn.btn-info(href=`/EditResena/${juego.IDJuego}/${resen.IDResena}`) Editar tu Reseña
              br
           else if licencia.Estado == 'Baneada'
            div(class="col btn btn-link" style="Padding-bottom: 40px;")  
             p Licencia Revocada debido a: #{ban.Motivo}
             br
             a.btn.btn-danger(href=`/CrearAppeal/${licencia.IDLic}`) Apelar
             br
         br
         h2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Reseñas ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ 
         div(class="Container-fluid text-center justify-content-center")
          for resena in resenas
           if resena.Numero >= 7     
            div(class="col" style="Min-width: 180px; Min-height: 150px; border: 5px solid rgb(228, 164, 69); display: inline-block; margin: 10px; background: rgb(119, 150, 109);") 
             br
             p Calificacion: #{resena.Numero}/10
             p #{resena.Texto}
             p Fecha: #{resena.Fecha}
           else if resena.Numero >=4 && resena.Numero < 7
            div(class="col" style="Min-width: 180px; Min-height: 150px; border: 5px solid rgb(179, 179, 179); display: inline-block; margin: 10px; background: rgb(219, 219, 44);") 
             br
             p Calificacion: #{resena.Numero}/10
             p #{resena.Texto}
             p Fecha: #{resena.Fecha}
           else
            div(class="col" style="Min-width: 180px; Min-height: 150px; border: 5px solid rgb(56, 56, 56); display: inline-block; margin: 10px; background: rgb(204, 102, 102);") 
             br
             p Calificacion: #{resena.Numero}/10
             p #{resena.Texto}
             p Fecha: #{resena.Fecha}
        br
        div(class="Container-fluid text-center justify-content-center")   
         if activeUser.Team == team.IDTeam
          div(class="col btn btn-link" style="Padding-bottom: 40px;")  
           a.btn.btn-info(href=`/EditJuego/${juego.IDJuego}`) Editar
           br  
          div(class="col btn btn-link" style="Padding-bottom: 40px;")  
           a.btn.btn-info(href=`/VerLicencias/${juego.IDJuego}`) Administrar Licencias
           br 
          div(class="col btn btn-link" style="Padding-bottom: 40px;")  
           a.btn.btn-info(href=`/VerCategorias/${juego.IDJuego}`) Administrar Categorias
           br
          div(class="col btn btn-link" style="Padding-bottom: 40px;")  
           a.btn.btn-info(href=`/CrearUpdate/${juego.IDJuego}`) Añadir Update
           br
         if activeUser.Admin == true && juego.Estado == 'Activo'
          div(class="col btn btn-link" style="Padding-bottom: 40px;")  
           a.btn.btn-info(href=`/BanJuego/${juego.IDJuego}`) Banear Juego
           br
         if activeUser.Admin == true && juego.Estado == 'Baneado'
          div(class="col btn btn-link" style="Padding-bottom: 40px;")  
           a.btn.btn-info(href=`/BanJuego/${juego.IDJuego}`) Rehabilitar Juego
           br
         div(class="col btn btn-link" style="Padding-bottom: 40px;")
          a.btn.btn-warning(href=`/`) Volver
          br