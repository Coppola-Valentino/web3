include bar.pug
+bar()
block content
        div(style="max-width: 1500px; border: 5px solid #000000ff; margin: 0 auto; padding-left: 10px; padding-right: 10px; display: flex; justify-content: space-between; flex-direction: column; horizontal-align: center; margin-top: 80px; background: rgba(255, 255, 255, 1)")
         div(class="Container-fluid text-center justify-content-center")
          br
          h1 #{juego.Nombre}
          div(class="col btn btn-link" style="border: 5px solid #000000ff; display: inline-block; background: rgb(56, 56, 56);") 
           img(src=`/Imagenes/${juego.Imagen}`, alt="Imagen", style="width:200px; height:200px; object-fit:cover;") 
         br
         h2 Precio: $#{juego.Precio}
         br
         div(class="Container-fluid text-center justify-content-center")
          p Desarrollado por:
          a(href=`/verTeam/${team.IDTeam}`)
           p #{team.Nombre} 
          p Publicado por:
          if publisher
           a(href=`/verPublisher/${publisher.IDPublisher}`)
            p #{publisher.Nombre} 
          else
           p Independiente
          br
         h3 Descripcion:
         div(style="border: 5px solid #000000ff; display: inline-block; padding-left: 5px; background: rgb(204, 204, 204);")
          p #{juego.Descripcion}
         //for categs in categorias
         //  p #{categs.Contenido} -
         br
         if licencia.length == 0
          div(class="col btn btn-link" style="Padding-bottom: 40px;")  
           a.btn.btn-success(href=`/ConfirmarComp/${juego.IDJuego}`) Comprar
           br 
         else 
           div(class="col btn btn-link" style="Padding-bottom: 40px;")  
            a.btn.btn-success(href=`/VerBiblioteca`) En tu Biblioteca
            br 
        br
        div(class="Container-fluid text-center justify-content-center")   
         if activeUser.Team == team.IDTeam
          div(class="col btn btn-link" style="Padding-bottom: 40px;")  
           a.btn.btn-info(href=`/EditJuego/${juego.IDJuego}`) Editar
           br    
         div(class="col btn btn-link" style="Padding-bottom: 40px;")
          a.btn.btn-warning(href=`/`) Volver
          br