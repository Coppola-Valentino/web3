include bar.pug
+bar()
block content
        div(style="max-width: 1500px; border: 5px solid #000000ff; margin: 0 auto; padding-left: 10px; padding-right: 10px; display: flex; justify-content: space-between; flex-direction: column; horizontal-align: center; margin-top: 80px; background: rgba(255, 255, 255, 1)")
         div(class="Container-fluid text-center justify-content-center")
          br
          h1 #{publisher.Nombre}
          div(class="col btn btn-link" style="border: 5px solid #000000ff; display: inline-block; background: rgb(56, 56, 56);") 
           img(src=`/Imagenes/${publisher.Banner}`, alt="Banner", style="width: 300px; height: 300px; object-fit:cover;") 
         br
         h2 ~~~~~~~~~~~~~~~~~~~~~~~~~~ Juegos Publicados ~~~~~~~~~~~~~~~~~~~~~~~~~  
         div(class="Container-fluid text-center justify-content-center")
          for game in juegos      
           div(class="col btn btn-link" style="Padding-bottom: 40px; border: 5px solid #000000ff; display: inline-block; margin: 10px; background: rgb(56, 56, 56);")
            a(href=`/VerJuego/${game.IDJuego}`)
             p #{game.Nombre}
             br
             img(src=`/Imagenes/${game.Imagen}`, alt="Imagen", style="width:200px; height:200px; object-fit:cover;") 
         br
         h2 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ Miembros ~~~~~~~~~~~~~~~~~~~~~~~~~~~~
         div(class="Container-fluid text-center justify-content-center")
          for miembro in equipo      
           div(class="col btn btn-link" style="Padding-bottom: 40px; border: 5px solid rgb(148, 148, 148); display: inline-block; margin: 10px; background: rgb(56, 56, 56);")
            a(href=`/VerUsuario/${miembro.IDUser}`)
             p #{miembro.Nombre}
             br
             img(src=`/Imagenes/${miembro.Avatar}`, alt="Avatar", style="width:200px; height:200px; object-fit:cover;")
        div(class="Container-fluid text-center justify-content-center")  
         if activeUser.IDUser == publisher.FundadorID
          div(class="col btn btn-link" style="Padding-bottom: 40px;")  
           a.btn.btn-info(href=`/EditPublisher/${publisher.IDPublisher}`) Administrar Publisher
           br    
         div(class="col btn btn-link" style="Padding-bottom: 40px;")
          a.btn.btn-warning(href=`/`) Volver
          br