include bar.pug
+bar()
block content
div(style="max-width: 1500px; border: 5px solid #000000ff; margin: 0 auto; padding-left: 10px; padding-right: 10px; display: flex; justify-content: space-between; flex-direction: column; horizontal-align: center; margin-top: 80px; background: rgba(255, 255, 255, 1)")
         h1 Añadir Tarjeta
         form(action=`/CrearTarjeta` method="POST" id="formi" style="display: flex; flex-direction: column; gap: 1px;" )
           label(for="Nombre") Nombre:
           input(type="text" name="Nombre" id="Nombre" required)
           br
           label(for="Numero") Numero de Tarjeta:
           input(type="number" name="Numero" id="Numero" required)
           br
           label(for="NumeroSeguridad") Numero de Seguridad:
           input(type="number" name="NumeroSeguridad" id="NumeroSeguridad" required)
           br
           button(class="btn btn-primary" type="submit") Guardar
           br
div(class="Container-fluid text-center justify-content-center")      
 div(class="col btn btn-link" style="Padding-bottom: 40px;")
  a.btn.btn-warning(href=`/VerTarjeta`) Volver
  br