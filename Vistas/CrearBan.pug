include bar.pug
+bar()
block content
div(style="max-width: 1500px; border: 5px solid #000000ff; margin: 0 auto; padding-left: 10px; padding-right: 10px; display: flex; justify-content: space-between; flex-direction: column; horizontal-align: center; margin-top: 80px; background: rgba(255, 255, 255, 1)")
         h1 Formulario de Suspencion de Licencia
         form(action=`/CrearBan/${Licen.IDLic}` method="POST" id="formi" style="display: flex; flex-direction: column; gap: 1px;" )
           label(for="Motivo") Motivo:
           input(type="text" name="Motivo" id="Motivo" required)
           br
           label(for="Duracion") Banear hasta:
           input(type="date" name="Duracion" id="Duracion" required)
           br
           button(class="btn btn-primary" type="submit") Guardar
           br
           a.btn.btn-warning(href="/") Cancelar
           br