include bar.pug
+bar()
block content
        div(style="max-width: 1500px; border: 5px solid #000000ff; margin: 0 auto; padding-left: 10px; padding-right: 10px; display: flex; justify-content: space-between; flex-direction: column; horizontal-align: center; margin-top: 80px; background: rgba(255, 255, 255, 1)")
         h1 Apelacion de: #{user.Nombre}
         p Razon del baneo: #{ban.Motivo}
         p Baneado hasta: #{ban.Duracion}
         p el Usuario cree que deberia ser apelado porque: #{appeal.Contenido}
         p Estado de la apelacion: #{appeal.Estado}
         if appeal.Estado == "Aceptado" || appeal.Estado == "Rechazado"
            p Manejado por: #{admin.Nombre}
         else 
          div(class="Container-fluid text-center justify-content-center")      
           div(class="col btn btn-link" style="Padding-bottom: 40px;")
            a.btn.btn-success(href=`/AceptarAppeal/${appeal.IDAppeal}`) Aceptar
            br
           div(class="col btn btn-link" style="Padding-bottom: 40px;")
            a.btn.btn-danger(href=`/RechazarAppeal/${appeal.IDAppeal}`) Rechazar
            br
        div(class="Container-fluid text-center justify-content-center")      
         div(class="col btn btn-link" style="Padding-bottom: 40px;")
          a.btn.btn-warning(href=`/`) Volver
          br