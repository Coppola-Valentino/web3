mixin bar()
 doctype html
 html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Floppy Disk
    body(style="background: rgb(26, 83, 85); background-image: url('/Imagenes/Icons/FloppyBack.png'); background-size: cover; background-repeat: no-repeat; background-attachment: fixed;")
        link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet")
        script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js")
        div(style="border-bottom: 5px solid rgb(0,0,0); background: rgb(26, 83, 85); padding-bottom: 10px; margin: 0 auto; display: flex; justify-content: space-between; flex-direction: column; horizontal-align: center; padding-top: 5px;")
         div(class="Container-fluid text-center" style="margin-top: 5px; border: 5px solid rgb(2, 131, 71) background: rgb(26, 83, 85);")
         header(class="d-flex flex-wrap justify-content-center")
            div(class="col-1" style="Margin-left: 70px; Margin-top: 10px;")
             img(src="/Imagenes/Icons/FloppyDisk.png", alt="Logo" width="50" height="50")
            div(class="col-2 btn" style="Margin-right: 240px;")
             a.btn.btn-success(href="/Home" style="min-width: 250px; min-height: 50px; padding-top: 10px;") Floppy Disk
            if activeUser
             div(class="col btn btn-link")
               a.btn.btn-primary(href=`/VerBiblioteca`) Biblioteca
             div(class="col btn btn-link")
               a.btn.btn-primary(href=`/VerUsuario/${activeUser.IDUser}`) Perfil
             div(class="col btn btn-link")
               a.btn.btn-primary(href=`/FriendList`) Amigos
             div(class="col btn btn-link")
               a.btn.btn-primary(href=`/Mensajeria`) Mensajeria
             if activeUser.Team != null
              div(class="col btn btn-link")
                a.btn.btn-primary(href=`/VerTeam/${activeUser.Team}`) Ver Team 
             else
              div(class="col btn btn-link")
                a.btn.btn-primary(href=`/CrearTeam`) Crear Dev Team 
             if activeUser.Publish != null
              div(class="col btn btn-link")
                a.btn.btn-primary(href=`/VerPublisher/${activeUser.Publish}`) Ver Publisher
             else
              div(class="col btn btn-link")
                a.btn.btn-primary(href=`/CrearPublisher`) Publishment 
             if activeUser.Admin == true 
              div(class="col btn btn-link")
                a.btn.btn-primary(href=`/VerAppeals2`) Appeals 
             div(class="col btn btn-link")
               a.btn.btn-primary(href=`/Logout`) Log Out     
            if !activeUser  
             div(class="col btn btn-link")
              a.btn.btn-primary(href="/Login") Log In
             div(class="col btn btn-link")
              a.btn.btn-primary(href="/CrearUsuario") Register