include bar.pug
+bar()
block content
div(style="max-width: 1500px; border: 5px solid #000000ff; margin: 0 auto; padding-left: 10px; padding-right: 10px; display: flex; justify-content: space-between; flex-direction: column; horizontal-align: center; margin-top: 80px; background: rgba(255, 255, 255, 1)")
         h1 Añadir juego
         form(action=`/CrearJuego` method="POST" id="formi" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 1px;" )
           label(for="Nombre") Nombre:
           input(type="text" name="Nombre" id="Nombre" required)
           br
           label(for="Precio") Precio:
           input(type="number" name="Precio" id="Precio" required)
           br
           label(for="Descripcion") Descripcion:
           input(type="text" name="Descripcion" id="Descripcion" required)
           br
           label(for="Imagen") Portada:
           input(type="file" name="Imagen" id="Imagen" accept="image/*") 
           br
           label(for="Archivo") Archivos del Juego: (.zip o .rar) 
           input(type="file" name="Archivo" id="Archivo" accept=".zip,.rar, application/zip,application/x-zip-compressed")
           br
           label(for="PublisherID") Publisher:
           select(name="PublisherID" id="PublisherID")
             option(value=null) Sin Publisher
             each publisher in publishers
               option(value=publisher.IDPublisher)= publisher.Nombre
           br
           button(class="btn btn-primary" type="submit") Guardar
           br
           a.btn.btn-warning(href="/") Cancelar
           br