mixin bar()
 doctype html
 html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Floppy Disk
    body(style="background: rgb(184, 253, 219);")
        link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet")
        div(style="max-width: 960px; margin: 0 auto; display: flex; justify-content: space-between; flex-direction: column; horizontal-align: center; padding-top: 95px;")
         div(class="Container-fluid text-center" style="margin-top: 5px; border: 5px solid rgb(2, 131, 71) background: rgba(57, 255, 205, 1)")
         header(class="d-flex flex-wrap justify-content-center")
            div(class="col-4")
             img(src="/Imagenes/Icons/FloppyDisk.png", alt="Logo")
            div(class="col-2 btn btn-success")
             a.btn.btn-success(href="/Home") Floppy Disk
            if activeUser
             div(class="col btn btn-link")
               a.btn.btn-primary(href=`/VerUsuario/${activeUser.IDUser}`) Perfil
            if !activeUser  
             div(class="col btn btn-link")
              a.btn.btn-primary(href="/Login") Log In
             div(class="col btn btn-link")
              a.btn.btn-primary(href="/CrearUsuario") Register