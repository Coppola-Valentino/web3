include bar.pug
+bar()
block content
div(style="max-width: 1500px; border: 5px solid #000000ff; margin: 0 auto; padding-left: 10px; padding-right: 10px; display: flex; justify-content: space-between; flex-direction: column; horizontal-align: center; margin-top: 20px; background: rgba(255, 255, 255, 1)")
    h1 Lista de Licencias de #{juego.Nombre}
    table
     thead
      tr
       th Usuario
       th Estado
       th Acciones
     tbody(id="PagBody")
    div(id="pagination")
    br

div(class="Container-fluid text-center justify-content-center")    
 div(class="col btn btn-link" style="Padding-bottom: 40px;")
  a.btn.btn-warning(href=`/`) Volver
  br
 div(class="col btn btn-link" style="Padding-bottom: 40px;")
  a.btn.btn-info(href=`/VerBans/${juego.IDJuego}`) Historial
  br
script.
  let page = 1;
  const pageSize = 10;
  const juegoId = !{JSON.stringify(juego.IDJuego)};
  function RenderPag(licencias) {
    const tbody = document.getElementById('PagBody');
    tbody.innerHTML = '';
    licencias.forEach(lic => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td><a href="/VerUsuario/${lic.user.IDUser}">${lic.user.Nombre}</a></td>
        <td>${lic.Estado}</td>
        <td>
          ${lic.Estado === 'Activa' ? `<a class="btn btn-warning" href="/CrearBan/${lic.IDLic}">Banear usuario</a>` : ''}
          ${lic.Estado === 'Baneada' ? `<a class="btn btn-warning" href="/ElimBan/${lic.IDLic}">Deshacer</a><br><a class="btn btn-info" href="/VerAppeals/${lic.IDLic}">ver Apelaciones</a>` : ''}
        </td>
      `;
      tbody.appendChild(tr);
    });
  }
  function renderPagination(total, page, pageSize) {
    const div = document.getElementById('pagination');
    const totalPages = Math.ceil(total / pageSize);
    let html = '';
    for (let i = 1; i <= totalPages; i++) {
      html += `<button onclick="goToPage(${i})" ${i === page ? 'disabled' : ''}>${i}</button> `;
    }
    div.innerHTML = html;
  }
  function goToPage(p) {
    page = p;
    fetchPag();
  }
  function fetchPag() {
    fetch(`/VerLicencias/${juegoId}?page=${page}&pageSize=${pageSize}`, {
      headers: { 'Accept': 'application/json' }
    })
      .then(res => res.json())
      .then(data => {
        RenderPag(data.licencias);
        renderPagination(data.total, data.page, data.pageSize);
      });
  }
  document.addEventListener('DOMContentLoaded', fetchPag);