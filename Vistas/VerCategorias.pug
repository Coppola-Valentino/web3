include bar.pug
+bar()
block content
div(style="max-width: 1500px; border: 5px solid #000000ff; margin: 0 auto; padding-left: 10px; padding-right: 10px; display: flex; justify-content: space-between; flex-direction: column; horizontal-align: center; margin-top: 80px; background: rgba(255, 255, 255, 1)")
    h1 Lista de Categorias de: #{juego.Nombre}
    table
     thead
      tr
       th Categoria
       th Acciones
     tbody(id="PagBody")
    div(id="pagination")
    br
    div(class="Container-fluid text-center justify-content-center")  
      form(action=`/CrearCategorias/${juego.IDJuego}` method="POST" id="formi" style="display: flex; flex-direction: column; gap: 1px;" )
        label(for="Contenido") Nueva Categoria:
        input(type="text" name="Contenido" id="Contenido" required)
        br
        button(class="btn btn-primary" type="submit") Añadir
        br
div(class="Container-fluid text-center justify-content-center") 
 div(class="col btn btn-link" style="Padding-bottom: 40px;")
  a.btn.btn-warning(href=`/`) Volver
  br
script.
  let page = 1;
  const pageSize = 10;
  const JuegoID = !{JSON.stringify(juego.IDJuego)};
  function RenderPag(categorias) {
    const tbody = document.getElementById('PagBody');
    tbody.innerHTML = '';
    categorias.forEach(cat => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td>${cat.Contenido}</td>
        <td><a class="btn btn-warning" href="/ElimCategorias/${JuegoID}/${cat.IDCategoria}"> Eliminar </a></td>
      `;
      tbody.appendChild(tr);
    });
  }
  function renderPagination(total, page, pageSize) {
    const div = document.getElementById('pagination');
    const totalPages = Math.ceil(total / pageSize);
    let html = '';
    for (let i = 1; i <= totalPages; i++) {
      html += `<button onclick="goToPage(${i})" ${i === page ? 'disabled' : ''}>${i}</button> `;
    }
    div.innerHTML = html;
  }
  function goToPage(p) {
    page = p;
    fetchPag();
  }
  function fetchPag() {
    fetch(`/VerCategorias/${JuegoID}?page=${page}&pageSize=${pageSize}`, {
      headers: { 'Accept': 'application/json' }
    })
      .then(res => res.json())
      .then(data => {
        RenderPag(data.categorias);
        renderPagination(data.total, data.page, data.pageSize);
      });
  }
  document.addEventListener('DOMContentLoaded', fetchPag);