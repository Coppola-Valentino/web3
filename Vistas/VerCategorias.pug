include bar.pug
+bar()
block content
div(style="max-width: 1500px; border: 5px solid #000000ff; margin: 0 auto; padding-left: 10px; padding-right: 10px; display: flex; justify-content: space-between; flex-direction: column; horizontal-align: center; margin-top: 80px; background: rgba(255, 255, 255, 1)")
    h1 Lista de Categorias de: #{juego.Nombre}
    table
     thead
      tr
       th Categoria
       th Acciones
        tbody
         each cat in categorias
          tr
           td= cat.Contenido
           td
             a.btn.btn-warning(href=`/ElimCategorias/${juego.IDJuego}/${cat.IDCategoria}`) Eliminar
    br
    div(class="Container-fluid text-center justify-content-center")  
      form(action=`/CrearCategorias/${juego.IDJuego}` method="POST" id="formi" style="display: flex; flex-direction: column; gap: 1px;" )
        label(for="Contenido") Nueva Categoria:
        input(type="text" name="Contenido" id="Contenido" required)
        br
        button(class="btn btn-primary" type="submit") Añadir
        br
div(class="Container-fluid text-center justify-content-center") 
 div(class="col btn btn-link" style="Padding-bottom: 40px;")
  a.btn.btn-warning(href=`/`) Volver
  br