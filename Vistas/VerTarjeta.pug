include bar.pug
+bar()
block content
div(style="max-width: 1500px; border: 5px solid #000000ff; margin: 0 auto; padding-left: 10px; padding-right: 10px; display: flex; justify-content: space-between; flex-direction: column; horizontal-align: center; margin-top: 80px; background: rgba(255, 255, 255, 1)")
    h1 Tarjetas Registradas
    table
     thead
      tr
       th Nombre
       th Numero de Tarjeta
       th Saldo
       th Acciones
        tbody
         each tarjeta in tarjetas
          tr
           td= tarjeta.Nombre
           td= tarjeta.Numero
           td= tarjeta.Saldo
           td
            a.btn.btn-info(href=`/EditTarjeta/${tarjeta.IDTarjeta}`) Administrar Tarjeta
            a.btn.btn-warning(href=`/BorrarTarjeta/${tarjeta.IDTarjeta}`) Borrar Tarjeta
div(class="Container-fluid text-center justify-content-center")
 div(class="col btn btn-link" style="Padding-bottom: 40px;")
  a.btn.btn-success(href=`/CrearTarjeta`) Añadir Tarjeta
  br      
 div(class="col btn btn-link" style="Padding-bottom: 40px;")
  a.btn.btn-warning(href=`/`) Volver
  br