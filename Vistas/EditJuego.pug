include bar.pug
+bar()
block content
div(style="max-width: 1500px; border: 5px solid #000000ff; margin: 0 auto; padding-left: 10px; padding-right: 10px; display: flex; justify-content: space-between; flex-direction: column; horizontal-align: center; margin-top: 80px; background: rgba(255, 255, 255, 1)")
         h1 Editar juego
         form(action=`/EditJuego/${juego.IDJuego}` method="POST" id="formi" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 1px;" )
           label(for="Nombre") Nombre:
           input(type="text" name="Nombre" id="Nombre" required value=juego.Nombre)
           br
           label(for="Precio") Precio:
           input(type="double" name="Precio" id="Precio" required value=juego.Precio)
           br
           label(for="Descripcion") Descripcion:
           input(type="text" name="Descripcion" id="Descripcion" required value=juego.Descripcion)
           br
           label(for="Imagen") Portada:
           input(type="file" name="Imagen" id="Imagen" accept="image/*" value=juego.Imagen)
           br
           label(for="mantener") Conservar imagen actual
           input(type="checkbox" style="max-width: 170px; margin-top: 10px;" name="mantener" id="mantener" checked)
           br
           p Imagen Actual:
           img(src=`/imagenes/${juego.Imagen}` alt="Imagen actual" style="max-width: 200px; max-height: 200px;") 
           br
           label(for="Archivo") Archivos del Juego: (.zip o .rar) 
           input(type="file" name="Archivo" id="Archivo" accept=".zip,.rar, application/zip,application/x-zip-compressed" value=juego.Archivo)
           br
           label(for="mantener2") Conservar Archivo actual
           input(type="checkbox" style="max-width: 170px; margin-top: 10px;" name="mantener2" id="mantener2" checked)
           br
           //categorias de alguna manera
           button(class="btn btn-primary" type="submit") Guardar
           br
           a.btn.btn-warning(href="/") Cancelar
           br
script.
                document.getElementById('formi').addEventListener('submit', function(event) {
                  const NomImp = document.getElementById('Nombre');
                  const PreImp = document.getElementById('Precio');
                  const DesImp = document.getElementById('Descripcion');
                  if (NomImp.value.length > 20 || NomImp.value.length < 3) {
                    alert('El Nombre debe tener entre 3 y 20 caracteres');
                    event.preventDefault();
                  }
                  if (PreImp.value < 0 || PreImp.value > 150) {
                    alert('Precio No Valido.');
                    event.preventDefault();
                  }
                  if (DesImp.value.length > 200 || DesImp.value.length < 0) {
                    alert('La Descripcion debe tener entre 0 y 200 caracteres');
                    event.preventDefault();
                  }
                 });