include bar.pug
+bar()
block content
div(style="max-width: 1500px; border: 5px solid #000000ff; margin: 0 auto; padding-left: 10px; padding-right: 10px; display: flex; justify-content: space-between; flex-direction: column; horizontal-align: center; margin-top: 20px; background: rgba(255, 255, 255, 1)")
    h1 Historial de Updates de #{juego.Nombre}
    table
     thead
      tr
       th Nombre
       th Fecha 
       th Acciones
     tbody(id="PagBody")
    div(id="pagination")
    br
    if activeUser.Team == juego.DevID
     div(class="Container-fluid text-center justify-content-center")      
      div(class="col btn btn-link" style="Padding-bottom: 40px;")
       a.btn.btn-info(href=`/CrearUpdate/${juego.IDJuego}`) Añadir Update
       br

div(class="Container-fluid text-center justify-content-center")    
 div(class="col btn btn-link" style="Padding-bottom: 40px;")
  a.btn.btn-warning(href=`/`) Volver
  br
script.
  let page = 1;
  const pageSize = 10;
  const JuegoID = !{JSON.stringify(juego.IDJuego)};
  function RenderPag(updates) {
    const tbody = document.getElementById('PagBody');
    tbody.innerHTML = '';
    updates.forEach(update => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td>${update.Nombre}</td>
        <td>${update.Fecha}</td>
        <td>
          <a class="btn btn-info" href="/VerUpdate/${update.IDUpdate}">Ver Update a Detalle</a>
        </td>
      `;
      tbody.appendChild(tr);
    });
  }
  function renderPagination(total, page, pageSize) {
    const div = document.getElementById('pagination');
    const totalPages = Math.ceil(total / pageSize);
    let html = '';
    for (let i = 1; i <= totalPages; i++) {
      html += `<button onclick="goToPage(${i})" ${i === page ? 'disabled' : ''}>${i}</button> `;
    }
    div.innerHTML = html;
  }
  function goToPage(p) {
    page = p;
    fetchPag();
  }
  function fetchPag() {
    fetch(`/VerUpdates/${JuegoID}?page=${page}&pageSize=${pageSize}`, {
      headers: { 'Accept': 'application/json' }
    })
      .then(res => res.json())
      .then(data => {
        RenderPag(data.updates);
        renderPagination(data.total, data.page, data.pageSize);
      });
  }
  document.addEventListener('DOMContentLoaded', fetchPag);